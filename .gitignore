target/
node_modules/
dist/
pkg/
*.log
# assets never go to git: they live in the asset store (see README)
*.glb
*.gltf
*.png
*.jpg
*.avif
*.ktx2
*.bin
# the SDF Modeler saves <id>.thumb.webp next to each asset for its asset browser; it renders a missing one again
*.thumb.webp
out/
.vite/
.bricks/
.nmc/*
!.nmc/commands.json
!.nmc/judge/
kong.rules
# S24 saved meshes are a local cache written by the SDF Modeler save: never tracked
*.mesh
# baked by npm run audio:bake (tools/bake-audio.ts): MP3 strips, manifest.json, haa-processors.js
apps/web/public/audio/
# staged by npm run ui:fonts (tools/uiFont.ts bundle): the verified ui/fonts.json fonts
apps/web/public/fonts/
# verified logo source, generated AVIF and encoder report (tools/uiLogo.ts)
apps/web/public/images/

.cache/

# the pinned UI logo source is tracked (tools/uiLogo.ts, allowed by tools/guard.ts)
!/ui/logo.*.png
# rendered by haa from audio/*.haa.json for the owner to listen to: the .haa.json patch is the source, the render never goes to git
audio/*.wav
