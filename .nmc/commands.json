[
  {
    "name": "game-asset-tests",
    "command": "node --experimental-strip-types --test packages/game/test/gameAsset.test.ts",
    "timeout_s": 60
  },
  {
    "name": "sdf-port-typecheck",
    "command": "npm run typecheck",
    "timeout_s": 120,
    "after": [
      "game-asset-tests"
    ]
  },
  {
    "name": "sdf-port-build",
    "command": "npm run build",
    "timeout_s": 600,
    "after": [
      "sdf-port-typecheck"
    ]
  },
  {
    "name": "candy-content-pack",
    "command": "npm run content:pack -- /tmp/rf-pack-m1",
    "timeout_s": 60,
    "after": [
      "sdf-port-build"
    ]
  },
  {
    "name": "candy-assets-proof",
    "command": "node --experimental-strip-types tools/candyAssetsProof.ts",
    "timeout_s": 900,
    "after": [
      "candy-content-pack"
    ]
  },
  {
    "name": "mechanisms-physics-l12",
    "command": "node --experimental-strip-types --test --test-concurrency=1 packages/sim/test/mechanisms.test.ts packages/sim/test/mechanismsL12.test.ts",
    "timeout_s": 60,
    "after": [
      "candy-assets-proof"
    ]
  },
  {
    "name": "rf-tests",
    "command": "npm run test",
    "timeout_s": 900,
    "after": [
      "sdf-port-build",
      "mechanisms-physics-l12"
    ]
  },
  {
    "name": "rf-judge-m2",
    "command": "node --experimental-strip-types tools/judgeCard.ts m2",
    "timeout_s": 1800,
    "after": [
      "rf-tests"
    ]
  },
  {
    "name": "mech-manifest-tests",
    "command": "node --experimental-strip-types --test packages/game/test/mechanismsJson.test.ts packages/game/test/gameManifest.test.ts",
    "timeout_s": 120
  },
  {
    "name": "scene-view-tests",
    "command": "node --experimental-strip-types --test packages/game/test/sceneView.test.ts",
    "timeout_s": 60,
    "after": [
      "rf-judge-m2",
      "mech-manifest-tests"
    ]
  }
]
