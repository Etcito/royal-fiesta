[
  {
    "name": "sdf-port-typecheck",
    "command": "npm run typecheck",
    "timeout_s": 120
  },
  {
    "name": "sdf-port-build",
    "command": "npm run build",
    "timeout_s": 600,
    "after": [
      "sdf-port-typecheck"
    ]
  },
  {
    "name": "candy-content-pack",
    "command": "npm run content:pack -- /tmp/rf-pack-m1",
    "timeout_s": 60,
    "after": [
      "sdf-port-build"
    ]
  },
  {
    "name": "candy-assets-proof",
    "command": "node --experimental-strip-types tools/candyAssetsProof.ts",
    "timeout_s": 900,
    "after": [
      "candy-content-pack"
    ]
  },
  {
    "name": "rf-tests",
    "command": "npm run test",
    "timeout_s": 900,
    "after": [
      "sdf-port-build",
      "candy-assets-proof"
    ]
  },
  {
    "name": "rf-judge-m3",
    "command": "node --experimental-strip-types tools/judgeCard.ts m3",
    "timeout_s": 3000,
    "after": [
      "rf-tests"
    ]
  },
  {
    "name": "rf-judge-m4-candy",
    "command": "node --experimental-strip-types tools/judgeCard.ts m4 --item 0",
    "timeout_s": 1800,
    "after": [
      "rf-tests"
    ]
  },
  {
    "name": "rf-judge-m4-ice-slide-gates",
    "command": "node --experimental-strip-types tools/iceSlideCapture.ts",
    "timeout_s": 1800,
    "after": [
      "rf-tests"
    ]
  },
  {
    "name": "rf-judge-m4-jungle-crane-crossing",
    "command": "node --experimental-strip-types tools/judgeCard.ts m4 --item 2",
    "timeout_s": 1800,
    "after": [
      "rf-tests"
    ]
  },
  {
    "name": "rf-judge-m4-neon-piston-alley",
    "command": "node --experimental-strip-types tools/judgeCard.ts m4 --item 3",
    "timeout_s": 1800,
    "after": [
      "rf-tests"
    ]
  }
]
