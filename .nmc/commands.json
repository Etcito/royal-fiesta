[
  {
    "name": "m18-fetch-node",
    "command": "node --experimental-strip-types apps/headless/proofs/m18-raa-brick.ts --only fetch,node",
    "timeout_s": 60,
    "cwd": "."
  },
  {
    "name": "m18-node-loader",
    "command": "node --experimental-strip-types --test packages/game/test/animBrick.test.ts",
    "timeout_s": 60,
    "cwd": ".",
    "after": [
      "m18-fetch-node"
    ]
  },
  {
    "name": "m18-typecheck",
    "command": "npm run typecheck",
    "timeout_s": 60,
    "cwd": ".",
    "after": [
      "m18-node-loader"
    ]
  },
  {
    "name": "m18-build",
    "command": "npm run build",
    "timeout_s": 180,
    "cwd": ".",
    "after": [
      "m18-typecheck"
    ]
  },
  {
    "name": "m18-anim-brick-capture",
    "command": "env NMC_GPU_WAIT_S=45 node --experimental-strip-types tools/anim-brick-capture.mjs --built",
    "timeout_s": 600,
    "cwd": ".",
    "after": [
      "m18-build"
    ]
  },
  {
    "name": "m18-raa-brick-proof",
    "command": "node --experimental-strip-types apps/headless/proofs/m18-raa-brick.ts",
    "timeout_s": 180,
    "cwd": ".",
    "after": [
      "m18-anim-brick-capture"
    ]
  },
  {
    "name": "m18-tests",
    "command": "npm run test -- --test-concurrency=1",
    "timeout_s": 1800,
    "cwd": ".",
    "after": [
      "m18-raa-brick-proof"
    ]
  },
  {"name":"m19-fall-dive-bundle","command":"node --experimental-strip-types apps/headless/proofs/m19-penguin-anim.ts --build","timeout_s":60,"cwd":".","after":["m18-tests"]},
  {"name":"m19-fall-dive-video","command":"env NMC_GPU_WAIT_S=45 node --experimental-strip-types apps/headless/proofs/m19-penguin-anim.ts --capture --clips fall,dive --seconds 4 --output proofs/m19","timeout_s":600,"cwd":".","after":["m19-fall-dive-bundle"]},
  {"name":"m19-mid-waddle-judge","command":"python3 \"$NMC_JUDGE_CLIENT\" proofs/m19/waddle.png --description \"In-game mid-waddle skinned penguin: rounded dark body, cream face and belly, two black eyes, orange beak and separate orange feet, long flippers attached at the shoulders. Match the silhouette, proportions and materials of /refs/penguin-base-ortho.png; the pose must remain coherent without detached parts or torn skin.\" --reference /refs/penguin-base-ortho.png --min-score 6","timeout_s":60,"cwd":".","after":["m19-fall-dive-video"]}
]
