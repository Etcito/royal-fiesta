[
  {
    "name": "m17-mama-fetch",
    "command": "node --experimental-strip-types tools/bricks.ts fetch mama",
    "timeout_s": 60,
    "cwd": "."
  },
  {
    "name": "m17-bricks-check",
    "command": "node --experimental-strip-types tools/bricks.ts check",
    "timeout_s": 60,
    "cwd": ".",
    "after": [
      "m17-mama-fetch"
    ]
  },
  {
    "name": "m17-worker-bootstrap",
    "command": "node --experimental-strip-types --test --test-concurrency=3 apps/web/test/classicWorker.test.ts apps/web/test/mamaImpl.test.ts apps/web/test/meshPool.test.ts apps/web/test/mamaMaterials.test.ts",
    "timeout_s": 60,
    "cwd": ".",
    "after": [
      "m17-mama-fetch"
    ]
  },
  {
    "name": "m17-mesh-node",
    "command": "node --experimental-strip-types apps/headless/proofs/m17-sdf-runtime.ts --only mesh-node",
    "timeout_s": 1800,
    "cwd": ".",
    "after": [
      "m17-bricks-check",
      "m17-worker-bootstrap"
    ]
  },
  {
    "name": "m17-sdf-match",
    "command": "env NMC_GPU_WAIT_S=900 node --experimental-strip-types tools/m17SdfMatch.ts",
    "timeout_s": 3600,
    "cwd": ".",
    "after": [
      "m17-bricks-check",
      "m17-worker-bootstrap"
    ]
  }
]
