[
  {
    "name": "web-build",
    "command": "npm run web:build",
    "timeout_s": 900,
    "cwd": "."
  },
  {
    "name": "publish",
    "command": "node \"$NMC_GPU_CLIENT\" publish apps/web/dist/",
    "timeout_s": 600,
    "cwd": ".",
    "after": [
      "web-build"
    ]
  },
  {
    "name": "render-tour",
    "command": "env NMC_GPU_WAIT_S=1500 node --experimental-strip-types tools/uiTourRecord.ts --render proofs/ui/tour.input.json out/ui",
    "timeout_s": 1800,
    "cwd": ".",
    "after": [
      "publish"
    ]
  },
  {
    "name": "tour-record",
    "command": "node --experimental-strip-types tools/uiTourRecord.ts out/ui",
    "timeout_s": 120,
    "cwd": ".",
    "after": [
      "render-tour"
    ]
  },
  {
    "name": "proof-evidence",
    "command": "node scripts/proof/ui-screens.mjs --only evidence",
    "timeout_s": 120,
    "cwd": ".",
    "after": [
      "tour-record"
    ]
  }
]
