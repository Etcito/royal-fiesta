[
  {
    "name": "render-views",
    "command": "node --experimental-strip-types tools/renderViews.ts proofs/c3/views.input.json",
    "timeout_s": 3000
  },
  {
    "name": "judge-c3-pool-cloud",
    "command": "node --experimental-strip-types tools/judgeViews.ts \"$NMC_JUDGE_CLIENT\" proofs/c3/judge.input.json c3-pool-cloud",
    "timeout_s": 1200,
    "after": [
      "render-views"
    ]
  },
  {
    "name": "judge-c3-hammer-spinner",
    "command": "node --experimental-strip-types tools/judgeViews.ts \"$NMC_JUDGE_CLIENT\" proofs/c3/judge.input.json c3-hammer-spinner",
    "timeout_s": 1200,
    "after": [
      "render-views"
    ]
  },
  {
    "name": "judge-c3-platforms",
    "command": "node --experimental-strip-types tools/judgeViews.ts \"$NMC_JUDGE_CLIENT\" proofs/c3/judge.input.json c3-platforms",
    "timeout_s": 1200,
    "after": [
      "render-views"
    ]
  }
]
