[
  {
    "name": "sdf-port-tests",
    "command": "node --experimental-strip-types --test apps/web/test/sdfTint.test.ts",
    "timeout_s": 60
  },
  {
    "name": "sdf-port-typecheck",
    "command": "npm run typecheck",
    "timeout_s": 120,
    "after": [
      "sdf-port-tests"
    ]
  },
  {
    "name": "sdf-port-build",
    "command": "npm run build",
    "timeout_s": 600,
    "after": [
      "sdf-port-typecheck"
    ]
  },
  {
    "name": "mechanisms-probe",
    "command": "node --experimental-strip-types --test --test-concurrency=1 --test-name-pattern=50 packages/sim/test/mechanisms.test.ts",
    "timeout_s": 60,
    "after": [
      "sdf-port-build"
    ]
  },
  {
    "name": "mechanisms-physics-l12",
    "command": "node --experimental-strip-types --test --test-concurrency=1 packages/sim/test/mechanisms.test.ts packages/sim/test/mechanismsL12.test.ts",
    "timeout_s": 60,
    "after": [
      "mechanisms-probe"
    ]
  },
  {
    "name": "rf-tests",
    "command": "npm run test",
    "timeout_s": 900,
    "after": [
      "sdf-port-build",
      "mechanisms-physics-l12"
    ]
  },
  {
    "name": "rf-judge-m1",
    "command": "node --experimental-strip-types tools/judgeCard.ts m1",
    "timeout_s": 1800,
    "after": [
      "rf-tests"
    ]
  },
  {
    "name": "rf-judge-m2",
    "command": "node --experimental-strip-types tools/judgeCard.ts m2",
    "timeout_s": 1800,
    "after": [
      "rf-tests"
    ]
  },
  {
    "name": "mech-manifest-tests",
    "command": "node --experimental-strip-types --test packages/game/test/mechanismsJson.test.ts packages/game/test/gameManifest.test.ts",
    "timeout_s": 120
  }
]
