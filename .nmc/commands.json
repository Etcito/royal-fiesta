[
  {
    "name": "font-fetch",
    "command": "node --experimental-strip-types tools/uiFont.ts fetch",
    "timeout_s": 300,
    "cwd": "."
  },
  {
    "name": "font-upload",
    "command": "node --experimental-strip-types tools/uiFont.ts upload",
    "timeout_s": 600,
    "cwd": ".",
    "after": [
      "font-fetch"
    ]
  },
  {
    "name": "font-verify",
    "command": "node --experimental-strip-types tools/uiFont.ts verify",
    "timeout_s": 300,
    "cwd": ".",
    "after": [
      "font-upload"
    ]
  }
]
