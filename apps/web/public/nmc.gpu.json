{
  "format": "nmc.gpu",
  "version": 1,
  "page": "client.html",
  "query": "?mode=ops",
  "global": "window.nmcGpu.ops",
  "ops": {
    "hubLoopCapture": {
      "page": "play.html",
      "query": "?mode=ops",
      "description": "4-client piloted hub -> sprint match -> podium -> hub loop on one RAA port, in a 2x2 grid of 960x540 viewports, with PNG captures and flow events",
      "input": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "clients",
          "width",
          "height",
          "captureAt"
        ],
        "properties": {
          "clients": {
            "const": 4
          },
          "width": {
            "const": 1920
          },
          "height": {
            "const": 1080
          },
          "captureAt": {
            "type": "array",
            "minItems": 1,
            "maxItems": 4,
            "uniqueItems": true,
            "items": {
              "enum": [
                "hub",
                "match",
                "podium",
                "back-in-hub"
              ]
            },
            "description": "Strictly ordered subset: hub (120 frames with 3 remotes each), match (600 frames after all enter), podium (60 frames after all enter), back-in-hub (120 frames after done)"
          }
        }
      },
      "example": {
        "clients": 4,
        "width": 1920,
        "height": 1080,
        "captureAt": [
          "hub",
          "match",
          "podium",
          "back-in-hub"
        ]
      },
      "output": "{ captures: [{ name: 'hub-loop-<name>', width: 1920, height: 1080, mime: 'image/png', base64 }], adapter: { vendor, architecture, description, software }, renderer: 'raa', events }"
    },
    "roundCapture": {
      "description": "4-client in-page sprint round on one RAA port (2x2 grid of 960x540), PNG captures with the HUD drawn on",
      "input": {
        "type": "object",
        "required": [
          "clients",
          "profile",
          "width",
          "height",
          "captureAtS"
        ],
        "properties": {
          "clients": {
            "const": 4
          },
          "profile": {
            "const": "sprint"
          },
          "width": {
            "const": 1920
          },
          "height": {
            "const": 1080
          },
          "captureAtS": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "number",
              "minimum": 0,
              "maximum": 600
            },
            "description": "sim seconds, strictly ascending"
          }
        }
      },
      "example": {
        "clients": 4,
        "profile": "sprint",
        "width": 1920,
        "height": 1080,
        "captureAtS": [
          3,
          12,
          40
        ]
      },
      "output": "{ captures: [{ name: 'round-<t>s', width, height, mime: 'image/png', base64 }], adapter: { vendor, architecture, description, software }, renderer: 'raa' }"
    },
    "frameTiming": {
      "description": "1 client rendering race-bean-dash (40 obstacles, 8 characters) at 1920x1080: port.render frameMs over requestAnimationFrame frames after 60 warm-up frames",
      "input": {
        "type": "object",
        "required": [
          "frames",
          "width",
          "height"
        ],
        "properties": {
          "frames": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10000
          },
          "width": {
            "const": 1920
          },
          "height": {
            "const": 1080
          }
        }
      },
      "example": {
        "frames": 600,
        "width": 1920,
        "height": 1080
      },
      "output": "{ p50Ms, p95Ms (nearest rank), frames, adapter: { vendor, architecture, description, software } }"
    },
    "controlsProbe": {
      "page": "game.html",
      "query": "?mode=ops",
      "description": "1 client at 1280x720 on the player page: each case resets the character to spawn 0 facing +Z with the orbit camera behind, drives one input (real KeyboardEvents on window, a synthetic standard gamepad through navigator.getGamepads, pointer-lock movementX mousemoves) for holdMs, and records the projected screen x before and after (character cases: the local character; view cases: a world marker placed at screen centre) with a PNG capture each; refuses when RAA is unavailable",
      "input": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "width",
          "height",
          "content",
          "course",
          "cases"
        ],
        "properties": {
          "width": {
            "const": 1280
          },
          "height": {
            "const": 720
          },
          "content": {
            "enum": [
              "v0",
              "v1",
              "sdf"
            ]
          },
          "course": {
            "type": "string",
            "pattern": "^[a-z0-9-]{1,40}$",
            "description": "race or survival course id of the content (spawn 0 is used)"
          },
          "cases": {
            "type": "array",
            "minItems": 1,
            "maxItems": 16,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "name",
                "input",
                "holdMs"
              ],
              "properties": {
                "name": {
                  "type": "string",
                  "pattern": "^[a-z0-9-]{1,40}$",
                  "description": "unique per case"
                },
                "input": {
                  "enum": [
                    "KeyD",
                    "ArrowRight",
                    "stickRight",
                    "KeyA",
                    "ArrowLeft",
                    "stickLeft",
                    "mouseRight",
                    "rightStickRight"
                  ]
                },
                "holdMs": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 5000
                }
              }
            }
          }
        }
      },
      "example": {
        "width": 1280,
        "height": 720,
        "content": "v1",
        "course": "race-sprint",
        "cases": [
          {
            "name": "key-d",
            "input": "KeyD",
            "holdMs": 500
          },
          {
            "name": "arrow-right",
            "input": "ArrowRight",
            "holdMs": 500
          },
          {
            "name": "stick-right",
            "input": "stickRight",
            "holdMs": 500
          },
          {
            "name": "key-a",
            "input": "KeyA",
            "holdMs": 500
          },
          {
            "name": "arrow-left",
            "input": "ArrowLeft",
            "holdMs": 500
          },
          {
            "name": "stick-left",
            "input": "stickLeft",
            "holdMs": 500
          },
          {
            "name": "mouse-right",
            "input": "mouseRight",
            "holdMs": 500
          },
          {
            "name": "right-stick-right",
            "input": "rightStickRight",
            "holdMs": 500
          }
        ]
      },
      "output": "{ json: { renderer: 'raa', adapter: { vendor, architecture, description, software }, software, pageRef, content, course, cases: [{ name, input, subject: 'character' | 'view', device: 'keyboard' | 'synthetic-pad' | 'pointer-lock-events', beforeX, afterX, centreX, captures: [{ name, sha256, bytes, nonEmpty }] }] }, files: [<case>-before.png, <case>-after.png] } (S17 proofs/m15/controls.json)"
    },
    "gameCapture": {
      "page": "game.html",
      "query": "?mode=ops",
      "description": "Player flow on game.html (in-page with bots, 2 or 4 piloted clients over a LoopbackRelay tiled per planCanvases, or one relay client with net) with PNG captures at named moments; with reload it loads the content twice in the same page (cache layers persist); refuses when RAA is unavailable",
      "input": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "content",
          "flow",
          "clients",
          "width",
          "height",
          "captureAt"
        ],
        "properties": {
          "content": {
            "enum": [
              "v0",
              "v1",
              "sdf"
            ]
          },
          "course": {
            "type": "string",
            "pattern": "^[a-z0-9-]{1,40}$",
            "description": "plays that race or survival course as one sprint round with bots; clients 1, no net"
          },
          "flow": {
            "enum": [
              "match",
              "hub",
              "podium",
              "tour"
            ]
          },
          "clients": {
            "enum": [
              1,
              2,
              4
            ]
          },
          "width": {
            "type": "integer",
            "minimum": 64,
            "maximum": 3840
          },
          "height": {
            "type": "integer",
            "minimum": 64,
            "maximum": 2160
          },
          "captureAt": {
            "type": "array",
            "minItems": 1,
            "maxItems": 16,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^(loading|hub|podium|back-in-hub|match-[0-9]+(\\.[0-9]+)?s)$"
            },
            "description": "Moments of the flow in flow order, match seconds ascending (<= 600): hub = loading, hub; match = loading, match-<s>s, podium; podium = loading, podium; tour = loading, hub, match-<s>s, podium, back-in-hub"
          },
          "reload": {
            "type": "boolean"
          },
          "net": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "server",
              "party"
            ],
            "properties": {
              "server": {
                "type": "string",
                "pattern": "^wss?://\\S+$",
                "description": "relay URL passed at run time, redacted in records"
              },
              "party": {
                "const": 2
              }
            }
          }
        }
      },
      "example": {
        "content": "v1",
        "flow": "tour",
        "clients": 1,
        "width": 1920,
        "height": 1080,
        "captureAt": [
          "loading",
          "hub",
          "match-12s",
          "podium",
          "back-in-hub"
        ],
        "reload": true
      },
      "output": "{ json: { renderer: 'raa', adapter: { vendor, architecture, description, software }, software, pageRef, captures: [{ name, width, height, sha256, bytes, nonEmpty }], frameTiming: null, content, courses, events: [{ t, what }], report, reports }, files: [<moment>.png, and reload-<moment>.png with reload] } (S10 captures plus S17 events and content.report())"
    }
  }
}
