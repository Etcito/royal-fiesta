{
  "haa": 1,
  "id": "jungle-crank",
  "title": "Wooden crane ratchet and stretching rope",
  "inputs": [],
  "master": 0.7,
  "graph": {
    "duration": 2,
    "loop": true,
    "mode": "live",
    "nodes": [
      { "id": "pawl", "type": "pulse", "x": 40, "y": 40, "label": "Eight short ratchet clicks per second", "params": { "frequency": 8, "width": 0.008, "phase": 0, "jitter": 0.015, "shimmer": 0.12, "level": 0.65, "shape": "exponential" } },
      { "id": "pawl-body", "type": "filter", "x": 300, "y": 40, "label": "Hollow wooden pawl knocks", "params": { "cutoff": 780, "resonance": 1.2, "mode": "bandpass" } },
      { "id": "stretch", "type": "lfo", "x": 40, "y": 360, "label": "Slow rope tension wobble", "params": { "rate": 0.55, "depth": 1, "wave": "sine" } },
      { "id": "rope", "type": "oscillator", "x": 300, "y": 200, "label": "Low creaking rope at 90 Hz", "params": { "frequency": 90, "wave": "saw", "level": 0.14 } },
      { "id": "rope-filter", "type": "filter", "x": 560, "y": 200, "label": "Muffled rope fibres", "params": { "cutoff": 340, "resonance": 0.8, "mode": "lowpass" } },
      { "id": "rope-amp", "type": "gain", "x": 820, "y": 200, "label": "Rope stretch swells", "params": { "gain": 0.75 } },
      { "id": "wood", "type": "filter", "x": 1080, "y": 40, "label": "Soft 900 Hz wooden housing resonance", "params": { "cutoff": 900, "resonance": 0.8, "mode": "lowpass" } },
      { "id": "out", "type": "output", "x": 1340, "y": 40, "label": "Lever-controlled crank loop output", "params": { "gain": 0.65 } }
    ],
    "connections": [
      { "id": "pawl-audio", "from": "pawl", "to": "pawl-body", "target": "audio" },
      { "id": "pawl-wood", "from": "pawl-body", "to": "wood", "target": "audio" },
      { "id": "rope-pitch-wobble", "from": "stretch", "to": "rope", "target": "frequency", "amount": 6 },
      { "id": "rope-audio", "from": "rope", "to": "rope-filter", "target": "audio" },
      { "id": "rope-filter-wobble", "from": "stretch", "to": "rope-filter", "target": "cutoff", "amount": 70 },
      { "id": "rope-filtered", "from": "rope-filter", "to": "rope-amp", "target": "audio" },
      { "id": "rope-amplitude-wobble", "from": "stretch", "to": "rope-amp", "target": "gain", "amount": 0.2 },
      { "id": "rope-wood", "from": "rope-amp", "to": "wood", "target": "audio" },
      { "id": "crank-out", "from": "wood", "to": "out", "target": "audio" }
    ]
  }
}
