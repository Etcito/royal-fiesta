{
  "haa": 1,
  "id": "mech-motor",
  "title": "Soft piston motor whirr",
  "inputs": [],
  "master": 0.7,
  "graph": {
    "duration": 2,
    "loop": true,
    "mode": "live",
    "nodes": [
      { "id": "wobble", "type": "lfo", "x": 40, "y": 40, "label": "Gentle motor wobble", "params": { "rate": 1.5, "depth": 1, "wave": "sine" } },
      { "id": "rotor", "type": "oscillator", "x": 300, "y": 40, "label": "Quiet rotor harmonics", "params": { "frequency": 132, "wave": "saw", "level": 0.16 } },
      { "id": "whirr", "type": "oscillator", "x": 300, "y": 200, "label": "Rounded gear whirr", "params": { "frequency": 264, "wave": "triangle", "level": 0.1 } },
      { "id": "air", "type": "noise", "x": 300, "y": 360, "label": "Soft bearing air", "params": { "color": "pink", "level": 0.025, "width": 0 } },
      { "id": "soften", "type": "filter", "x": 560, "y": 200, "label": "Muffled motor housing", "params": { "cutoff": 1100, "resonance": 0.65, "mode": "lowpass" } },
      { "id": "breathe", "type": "gain", "x": 820, "y": 200, "label": "Slight amplitude wobble", "params": { "gain": 0.85 } },
      { "id": "out", "type": "output", "x": 1080, "y": 200, "label": "Continuous motor output", "params": { "gain": 0.65 } }
    ],
    "connections": [
      { "id": "rotor-wobble", "from": "wobble", "to": "rotor", "target": "frequency", "amount": 1.8 },
      { "id": "whirr-wobble", "from": "wobble", "to": "whirr", "target": "frequency", "amount": 3.6 },
      { "id": "rotor-audio", "from": "rotor", "to": "soften", "target": "audio" },
      { "id": "whirr-audio", "from": "whirr", "to": "soften", "target": "audio" },
      { "id": "air-audio", "from": "air", "to": "soften", "target": "audio" },
      { "id": "softened-audio", "from": "soften", "to": "breathe", "target": "audio" },
      { "id": "amplitude-wobble", "from": "wobble", "to": "breathe", "target": "gain", "amount": 0.08 },
      { "id": "motor-out", "from": "breathe", "to": "out", "target": "audio" }
    ]
  }
}
