{
  "haa": 1,
  "id": "mech-thud",
  "title": "Soft rubber mechanism impact",
  "inputs": [
    { "name": "gain", "kind": "continuous", "unit": "", "min": 0, "max": 1, "default": 1, "smooth": 0, "curve": "lin" }
  ],
  "master": 0.8,
  "graph": {
    "duration": 0.3,
    "loop": false,
    "mode": "timeline",
    "nodes": [
      { "id": "strength", "type": "input", "x": 560, "y": 520, "label": "Impact strength gain", "params": { "name": "gain" } },
      { "id": "pitch", "type": "curve", "x": 40, "y": 40, "label": "Rubber pitch drop", "params": { "amount": 1 }, "curve": [[0, 1], [0.06, 0.7], [0.18, 0.28], [0.42, 0.03], [0.7, 0], [1, 0]] },
      { "id": "body", "type": "oscillator", "x": 300, "y": 40, "label": "Low rubber body", "params": { "frequency": 65, "wave": "sine", "level": 0.8 } },
      { "id": "skin", "type": "noise", "x": 40, "y": 360, "label": "Soft impact surface", "params": { "color": "pink", "level": 0.22, "width": 0 } },
      { "id": "skin-filter", "type": "filter", "x": 300, "y": 360, "label": "Dull rubber contact", "params": { "cutoff": 460, "resonance": 0.65, "mode": "lowpass" } },
      { "id": "env", "type": "curve", "x": 300, "y": 200, "label": "Rounded 300 ms impact", "params": { "amount": 1 }, "curve": [[0, 0], [0.015, 0.85], [0.04, 1], [0.13, 0.6], [0.3, 0.25], [0.55, 0.08], [0.8, 0.015], [0.95, 0], [1, 0]] },
      { "id": "impact-amp", "type": "gain", "x": 560, "y": 200, "label": "Impact envelope", "params": { "gain": 0 } },
      { "id": "strength-amp", "type": "gain", "x": 820, "y": 200, "label": "Event strength scaling", "params": { "gain": 0 } },
      { "id": "out", "type": "output", "x": 1080, "y": 200, "label": "Thud output", "params": { "gain": 0.8 } }
    ],
    "connections": [
      { "id": "rubber-bend", "from": "pitch", "to": "body", "target": "frequency", "amount": 125 },
      { "id": "body-audio", "from": "body", "to": "impact-amp", "target": "audio" },
      { "id": "skin-audio", "from": "skin", "to": "skin-filter", "target": "audio" },
      { "id": "skin-filtered", "from": "skin-filter", "to": "impact-amp", "target": "audio" },
      { "id": "impact-envelope", "from": "env", "to": "impact-amp", "target": "gain" },
      { "id": "impact-audio", "from": "impact-amp", "to": "strength-amp", "target": "audio" },
      { "id": "event-gain", "from": "strength", "to": "strength-amp", "target": "gain" },
      { "id": "thud-out", "from": "strength-amp", "to": "out", "target": "audio" }
    ]
  }
}
