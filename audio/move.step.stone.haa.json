{
  "haa": 1,
  "id": "move.step.stone",
  "title": "Hard stone click-thud",
  "inputs": [{ "name": "speed", "kind": "continuous", "unit": "m/s", "min": 0, "max": 12, "default": 5, "smooth": 0, "curve": "lin" }],
  "master": 0.7,
  "graph": {
    "duration": 0.16, "loop": false, "mode": "timeline",
    "nodes": [
      {"id":"speed","type":"input","x":40,"y":40,"label":"Foot speed in m/s","params":{"name":"speed"}},
