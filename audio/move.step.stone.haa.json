      {"id":"take-decay","type":"random","x":520,"y":40,"label":"Seeded decay take","params":{"rate":0.05,"depth":1,"smooth":0}},
      {"id":"take-timing","type":"random","x":760,"y":40,"label":"Seeded contact timing jitter","params":{"rate":0.05,"depth":1,"smooth":0}},
      {"id":"body","type":"oscillator","x":40,"y":200,"label":"Contact body","params":{"frequency":135,"wave":"sine","level":0.68}},
      {"id":"body-env","type":"envelope","x":280,"y":200,"label":"Contact envelope with varied peak time","params":{"attack":0.003,"decay":0.065,"sustain":0,"hold":0.01,"release":0.01}},
      {"id":"body-amp","type":"gain","x":520,"y":200,"label":"Shape contact body","params":{"gain":0}},
      {"id":"texture","type":"noise","x":760,"y":200,"label":"Procedural surface texture","params":{"color":"white","level":0.8,"width":0}},
      {"id":"texture-env","type":"curve","x":40,"y":360,"label":"Surface transient and spectral contour","params":{"amount":1},"curve":[[0,0],[0.005,1],[0.025,0.6],[0.08,0.17],[0.2,0.035],[0.36,0],[1,0]]},
      {"id":"texture-amp","type":"gain","x":280,"y":360,"label":"Shape surface texture","params":{"gain":0}},
      {"id":"surface-filter","type":"filter","x":520,"y":360,"label":"Speed-dependent surface brightness","params":{"cutoff":2400,"resonance":0.7,"mode":"lowpass"}},
      {"id":"speed-amp","type":"gain","x":760,"y":360,"label":"Speed-dependent contact level","params":{"gain":0.18}},
      {"id":"out","type":"output","x":40,"y":520,"label":"Mono spatial-ready step","params":{"gain":0.75}}
