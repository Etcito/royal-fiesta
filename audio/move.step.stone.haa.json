    "connections": [
      {"id":"c1","from":"take-pitch","to":"body","target":"frequency","amount":35},
      {"id":"c2","from":"take-decay","to":"body-env","target":"decay","amount":0.02275},
      {"id":"c3","from":"take-timing","to":"body-env","target":"attack","amount":0.002},
      {"id":"c4","from":"texture-env","to":"body","target":"frequency","amount":210},
