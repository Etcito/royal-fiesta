      {"id":"c7","from":"body-env","to":"body-amp","target":"gain"},
      {"id":"c8","from":"texture","to":"texture-amp","target":"audio"},
      {"id":"c9","from":"texture-env","to":"texture-amp","target":"gain"},
      {"id":"c10","from":"body-amp","to":"surface-filter","target":"audio"},
      {"id":"c11","from":"texture-amp","to":"surface-filter","target":"audio"},
      {"id":"c12","from":"speed","to":"surface-filter","target":"cutoff","amount":300},
      {"id":"c13","from":"texture-env","to":"surface-filter","target":"cutoff","amount":3200},
      {"id":"c14","from":"surface-filter","to":"speed-amp","target":"audio"},
      {"id":"c15","from":"speed","to":"speed-amp","target":"gain","amount":0.065},
      {"id":"c16","from":"speed-amp","to":"out","target":"audio"}
    ]
