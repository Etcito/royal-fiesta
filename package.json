{
  "name": "royal-fiesta",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "test": "node --experimental-strip-types --test \"tools/test/*.test.ts\" \"packages/*/test/*.test.ts\" \"apps/headless/test/*.test.ts\" \"apps/web/test/*.test.ts\"",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "npm run web:build",
    "guard": "node --experimental-strip-types tools/guard.ts",
    "bricks": "node --experimental-strip-types tools/bricks.ts",
    "smoke": "node --experimental-strip-types apps/headless/src/smoke.ts",
    "rf": "node --experimental-strip-types apps/headless/src/cli.ts",
    "audio:bake": "node --experimental-strip-types tools/bake-audio.ts",
    "web:build": "npm run audio:bake && npm run build -w @royal-fiesta/web",
    "play": "node --experimental-strip-types tools/play.ts",
    "wavedash": "node --experimental-strip-types tools/wavedash.ts",
    "prepare": "git config core.hooksPath .githooks || true"
  },
  "devDependencies": {
    "@etcito/raa-assets-tools": "https://github.com/Etcito/raa-assets-tools/releases/download/v0.1.0/raa-assets-tools-0.1.0.tgz",
    "@types/node": "^24",
    "typescript": "^5.9.3"
  }
}
