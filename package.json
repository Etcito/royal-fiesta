{
  "name": "royal-fiesta",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "test": "node --experimental-strip-types --test \"tools/test/*.test.ts\" \"packages/*/test/*.test.ts\" \"apps/headless/test/*.test.ts\" \"apps/web/test/*.test.ts\"",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "typecheck:mama": "tsc --noEmit -p tsconfig.mama.json",
    "build": "npm run web:build",
    "guard": "node --experimental-strip-types tools/guard.ts",
    "bricks": "node --experimental-strip-types tools/bricks.ts",
    "smoke": "node --experimental-strip-types apps/headless/src/smoke.ts",
    "rf": "node --experimental-strip-types apps/headless/src/cli.ts",
    "zone:bots": "node --experimental-strip-types apps/headless/src/zoneLaunch.ts",
    "round:run": "node --experimental-strip-types apps/headless/src/roundRun.ts",
    "audio:bake": "node --experimental-strip-types tools/bake-audio.ts",
    "ui:fonts": "node --experimental-strip-types tools/uiFont.ts bundle",
    "web:build": "npm run audio:bake && npm run ui:fonts && npm run build -w @royal-fiesta/web",
    "content:pack": "node --experimental-strip-types tools/content.ts",
    "play": "node --experimental-strip-types tools/play.ts",
    "wavedash": "node --experimental-strip-types tools/wavedash.ts",
    "levels:publish": "node --experimental-strip-types tools/levels/pack.ts",
    "etcito:build": "node --experimental-strip-types tools/etcitoBuild.ts",
    "prepare": "git config core.hooksPath .githooks || true"
  },
  "dependencies": {
    "@etcito/raa-anim": "file:../raa/dist/bricks/raa-anim",
    "@etcito/uaa": "file:../uaa"
  },
  "devDependencies": {
    "@etcito/haa-spatial": "file:../haa/packages/haa",
    "@etcito/raa-assets-tools": "https://github.com/Etcito/raa-assets-tools/releases/download/v0.1.0/raa-assets-tools-0.1.0.tgz",
    "@types/node": "^24",
    "sharp": "0.35.5",
    "typescript": "^5.9.3"
  }
}
